/**
 * Cheatsheet picker derived from the shared Dracula desktop launcher theme.
 */

@import "desktop.rasi"

mainbox {
    children: [ "inputbar", "listview", "message" ];
}

entry {
    placeholder: "Cheatsheet suchen …";
}

listview {
    columns: 1;
    lines: 12;
    fixed-columns: true;
    fixed-height: true;
}

element-icon {
    enabled: false;
}

mode-switcher {
    enabled: false;
}
