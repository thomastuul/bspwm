/*****----- Configuration -----*****/
configuration {
    modi:                 "drun,window,ssh,calc:~/.config/bspwm/bin/rofi-calculator.sh";
    show-icons:           true;
    display-drun:         " Apps";
    display-filebrowser:  " Dateien";
    display-window:       " Fenster";
    display-ssh:          " SSH";
    display-calc:         " Rechner";
    drun-display-format:  "{name}";
    window-format:        "{w} · {c} · {t}";
}

/*****----- Global Properties -----*****/
@import "themes/desktop.rasi"
